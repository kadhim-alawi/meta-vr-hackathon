{
  "name": "foldlings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "models": "vite-node --config vitest.config.ts scripts/render-models.ts",
    "e2e": "node scripts/e2e/playthrough.mjs"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "iwer": "^2.5.0",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@types/three": "^0.181.0",
    "playwright": "1.64.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  },
  "description": "Foldlings: a hands-only mixed reality origami adventure for Meta Quest and Meta VR Glasses",
  "license": "MIT"
}
